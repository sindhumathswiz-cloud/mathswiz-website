# INSTRUCTIONS for Free PostgreSQL Database Setup
# -----------------------------------------------
# 1. Go to https://neon.tech or https://supabase.com
# 2. Sign up and create a new free PostgreSQL database.
# 3. Copy the provided connection string (URI).
# 4. Replace the "your_connection_string_here" below with your actual URI.
#    Make sure the string retains the `?sslmode=require` flags if provided by Neon!

DATABASE_URL="your_connection_string_here"

# Required for persistent serverless rate limiting.
# Create a Redis database and copy its REST credentials.
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_rest_token_here"

# Optional: enables automated Supabase backup-inventory verification.
SUPABASE_PROJECT_REF="your_project_reference"
SUPABASE_ACCESS_TOKEN="your_supabase_management_token"

# Optional development/pilot location for private whole-book PDFs.
# Keep this outside public/; production should use durable private object storage.
QB_PRIVATE_STORAGE_ROOT="D:/Mathswiz-private/book-ingestion"
