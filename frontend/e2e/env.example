# Copy to frontend/.env.staging (git-ignored). This is the staging database: admins import and approve content
# there, and the e2e suite wipes and recreates its fixtures there. It must NOT be the database in .env.local.
STAGING_DATABASE_URL=postgresql://postgres.YOUR_STAGING_PROJECT_REF:YOUR_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
